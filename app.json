{
  "expo": {
    "name": "BillMitra",
    "slug": "billmitra",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "billmitra",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "icon": "./assets/images/logo1.png",
    "plugins": [
      "expo-router",
      "@react-native-community/datetimepicker",
      "expo-secure-store"
    ],
    "android": {
      "package": "com.billmitra.billing"
    },
    "ios": {
      "bundleIdentifier": "com.billmitra.billing"
    }
  }
}
